# Housing homes deliberately share one compact, square footprint. The
# selected vault changes only the branch styling; all persistent Housing map
# identifiers remain independent of ordinary Crawl level ids.

NAME: housing_main
DESC: Dungeon
ORDER: 1
TAGS: housing housing_start no_monster_gen no_item_gen no_trap_gen no_rotate no_hmirror no_vmirror
ORIENT: encompass
KFEAT: @ = runelight
LFLOORCOL: lightgrey
LROCKCOL: brown
LFLOORTILE: floor_normal
LROCKTILE: wall_normal
MAP
xxxxxxxxxxxxx
